# Control de versiones y metadatos de agentes
.git
.github
.agents

# Entornos virtuales y caches de Python
.venv
.venv-*
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
*.egg-info
**/*.egg-info

# Secretos y estado local
.env
.env.*
!.env.example
logs
*.db
*.sqlite
*.sqlite3

# No necesarios dentro de las imagenes
tests
endpoint_validator.py
uv.lock
README.md
compose.yaml
