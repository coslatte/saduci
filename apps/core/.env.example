# SADUCI Core — variables de entorno (docker compose lee apps/core/.env)
# Copia este archivo a .env y reemplaza cada placeholder con un valor fuerte:
#   cp .env.example .env
#
# En Windows: copy .env.example .env
# Genera los secretos reales con:  python scripts/saduci.py secrets

# ─── API Gateway ───────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-secret
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:4000
CORS_ALLOW_CREDENTIALS=true

# Token compartido para /api/internal/event (los servicios lo reenvían en la
# cabecera X-Internal-Token). Si se deja vacío, se usa SECRET_KEY.
INTERNAL_EVENT_TOKEN=

# Límite de intentos de login (por ventana, por IP)
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=60

# ─── User Service ──────────────────────────────────────────────────────
AUTH_USERNAME=replace-with-admin-username
AUTH_PASSWORD=replace-with-strong-admin-password
USER_DB_PASSWORD=replace-with-strong-user-db-password

# ─── Bases de datos ────────────────────────────────────────────────────
PREDICTION_DB_PASSWORD=replace-with-strong-prediction-db-password
SIMULATION_DB_PASSWORD=replace-with-strong-simulation-db-password
PATIENT_DB_PASSWORD=replace-with-strong-patient-db-password

# ─── Imágenes base ─────────────────────────────────────────────────────
# Si Docker Hub está bloqueado, usa el mirror público de AWS ECR (por defecto).
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16.3-alpine

# ─── Puertos publicados en el host ─────────────────────────────────────
# Los 4 microservicios de datos se acotan a 127.0.0.1: no son accesibles
# desde la red. Solo el gateway y el frontend publican puertos.
API_GATEWAY_HOST_PORT=7000
USER_HOST_PORT=7001
PREDICTION_HOST_PORT=7003
SIMULATION_HOST_PORT=7004
PATIENT_HOST_PORT=7002
PLATFORM_HOST_PORT=3000

# ─── URLs internas (dentro de la red de compose) ───────────────────────
# No las uses fuera de compose: el compose las fija por servicio.
USER_SERVICE_URL=http://user-service:7001
PREDICTION_SERVICE_URL=http://prediction-service:7003
SIMULATION_SERVICE_URL=http://simulation-service:7004
PATIENT_SERVICE_URL=http://patient-service:7002
GATEWAY_URL=http://api-gateway:7000

# ─── Proveedor de narrativa (predicción) ───────────────────────────────
PREDICTION_NARRATIVE_PROVIDER=stub
PREDICTION_LOCAL_LLM_URL=
PREDICTION_LOCAL_LLM_MODEL=
PREDICTION_LOCAL_LLM_TOKEN=
PREDICTION_GEMINI_API_KEY=
PREDICTION_GEMINI_MODEL=gemini-2.5-flash
PREDICTION_NARRATIVE_MODEL=
HUGGINGFACE_API_URL=
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_TIMEOUT_SECONDS=30

# ─── Otros ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
