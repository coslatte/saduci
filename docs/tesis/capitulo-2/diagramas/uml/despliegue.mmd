```mermaid
graph TD
    subgraph Internet["Red Externa"]
        User["Usuario<br/>Médico/Admin"]
    end

    subgraph SADUCI["Plataforma SADUCI"]
        subgraph DockerHost["Docker Host"]
            subgraph Frontend["Frontend Container"]
                Platform["saduci-platform<br/>:3000"]
            end

            subgraph Backend["Backend Containers"]
                Gateway["api-gateway<br/>:8000"]
                Pred["prediction<br/>:8002"]
                Sim["simulation<br/>:8003"]
            end

            subgraph Databases["Bases de Datos"]
                PredDB["prediction-db<br/>:5432"]
                SimDB["simulation-db<br/>:5432"]
            end
        end
    end

    User -->|"HTTPS"| Platform
    Platform -->|"HTTP"| Gateway
    Gateway -->|"internal"| Pred
    Gateway -->|"internal"| Sim
    Pred --> PredDB
    Sim --> SimDB

    style DockerHost fill:#f5f5f5,stroke:#333,stroke-width:2px
    style Databases fill:#ffcdd2
    style Frontend fill:#c8e6c9
    style Backend fill:#bbdefb
