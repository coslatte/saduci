# API Gateway Service Environment Variables
PORT=8000
LOG_LEVEL=INFO

# JWT Configuration
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Authentication Configuration
AUTH_USERNAME=replace-with-admin-username
AUTH_PASSWORD=replace-with-strong-admin-password

# CORS Configuration
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# Service URLs
PATIENT_SERVICE_URL=http://patient:8001
PREDICTION_SERVICE_URL=http://prediction:8002
SIMULATION_SERVICE_URL=http://simulation:8003
