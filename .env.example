# API Gateway
SECRET_KEY=replace-with-a-long-random-secret
AUTH_USERNAME=replace-with-admin-username
AUTH_PASSWORD=replace-with-strong-admin-password
API_GATEWAY_DB_PASSWORD=replace-with-strong-gateway-db-password

# Databases
PREDICTION_DB_PASSWORD=replace-with-strong-prediction-db-password
SIMULATION_DB_PASSWORD=replace-with-strong-simulation-db-password
PATIENT_DB_PASSWORD=replace-with-strong-patient-db-password

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# Optional host port overrides
API_GATEWAY_HOST_PORT=8000
PREDICTION_HOST_PORT=8002
SIMULATION_HOST_PORT=8003
PATIENT_HOST_PORT=8001

# Service URLs
PREDICTION_SERVICE_URL=http://prediction:8002
SIMULATION_SERVICE_URL=http://simulation:8003
PATIENT_SERVICE_URL=http://patient:8001

# Narrative provider defaults
PREDICTION_NARRATIVE_PROVIDER=stub
PREDICTION_LOCAL_LLM_URL=
PREDICTION_LOCAL_LLM_MODEL=
PREDICTION_LOCAL_LLM_TOKEN=
PREDICTION_GEMINI_API_KEY=
PREDICTION_GEMINI_MODEL=gemini-2.5-flash
PREDICTION_NARRATIVE_MODEL=

# Log Level
LOG_LEVEL=INFO
