# Environment variables for docker-compose
# Copy this to .env and customize for your environment

# JWT Secret Key (change this in production!)
SECRET_KEY=replace-with-a-long-random-secret

# API Gateway Login Credentials (required)
AUTH_USERNAME=replace-with-admin-username
AUTH_PASSWORD=replace-with-strong-admin-password

# Database Passwords (required)
PREDICTION_DB_PASSWORD=replace-with-strong-prediction-db-password
SIMULATION_DB_PASSWORD=replace-with-strong-simulation-db-password

# CORS Configuration
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# Optional host port overrides (useful on Windows when 8000-8003 are reserved)
API_GATEWAY_HOST_PORT=8000
PREDICTION_HOST_PORT=8002
SIMULATION_HOST_PORT=8003

# Log Level
LOG_LEVEL=INFO
